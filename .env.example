# Set these in your shell or CI secret store. This file is documentation, not auto-loaded.
SNOWFLAKE_ACCOUNT=organization-account
SNOWFLAKE_USER=your_demo_service_user
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/outside/repository/key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_CONSUMER_USER=your_separate_read_only_service_user
SNOWFLAKE_CONSUMER_PRIVATE_KEY_PATH=/absolute/path/outside/repository/consumer.p8
SNOWFLAKE_CONSUMER_PRIVATE_KEY_PASSPHRASE=
# Set RMP_ENTERPRISE_APPROVED=yes only after owner approval of actual fixture/cost evidence.
# Bootstrap uses REVENUE_METRICS_DEMO and RMP_WH. Roles: RMP_LOADER, RMP_BUILD, RMP_CONSUMER.
# App/analyst can review a cloud-generated publication without direct warehouse credentials:
REVENUE_PUBLICATION=.local/snowflake/published
